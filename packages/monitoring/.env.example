# NeuroWealth Monitoring Configuration

# Contract to monitor
VAULT_CONTRACT_ID=C...

# Network configuration
SOROBAN_RPC_URL=https://soroban.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Public Global Stellar Network ; Stellar Development Foundation

# Monitoring poll interval (seconds)
POLL_INTERVAL_SECONDS=30

# Alert thresholds
TVL_DROP_PERCENTAGE=20
WITHDRAWAL_SPIKE_FACTOR=3
PAUSE_DURATION_LEDGERS=17280
CAP_SATURATION_PERCENTAGE=95

# Slack webhook (optional)
SLACK_WEBHOOK_URL=

# Discord webhook (optional)
DISCORD_WEBHOOK_URL=

# Telegram webhook (optional)
TELEGRAM_WEBHOOK_URL=

# Prometheus metrics endpoint (optional)
METRICS_BACKEND_URL=

# Enable pause drill (runs pause/unpause test - use with caution)
ENABLE_PAUSE_DRILL=false
