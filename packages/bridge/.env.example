# Cross-Chain Bridge Configuration (Stellar ↔ Ethereum via Axelar)

# === STELLAR ===
STELLAR_RPC_URL=https://soroban.stellar.org
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; Stellar Development Foundation
STELLAR_VAULT_CONTRACT_ID=C...
STELLAR_USDC_TOKEN_ID=C...

# === ETHEREUM ===
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_CHAIN_ID=1
ETHEREUM_VAULT_CONTRACT_ADDRESS=0x...
ETHEREUM_USDC_TOKEN_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# === AXELAR ===
AXELAR_API_URL=https://api.axelarscan.io
AXELAR_CHAIN_NAME=ethereum
AXELAR_GAS_SERVICE_ADDRESS=0x...

# === BRIDGE SETTINGS ===
BRIDGE_FEE_PERCENTAGE=0.5
MIN_BRIDGE_AMOUNT=1000000
MAX_BRIDGE_AMOUNT=10000000000

# === DATABASE (Supabase or PostgreSQL) ===
DATABASE_URL=postgresql://user:password@localhost:5432/neurowealth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
