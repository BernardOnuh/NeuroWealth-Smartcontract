# =============================================================================
# NeuroWealth Mainnet Deployment Configuration
# =============================================================================
#
# Copy this file to .env.mainnet and fill in all required values
# NEVER commit .env.mainnet to version control
#
# Usage:
#   source .env.mainnet
#   ./scripts/deploy-mainnet.sh --dry-run
#   ./scripts/deploy-mainnet.sh
#
# =============================================================================

# === KEY MANAGEMENT ===
# CRITICAL: Use separate, secure keys for each role

# Temporary deployer key (single-use, will be discarded after deployment)
# Generate with: stellar keys generate
MAINNET_DEPLOYER_SECRET_KEY="S..."

# Cold/Multisig owner address (where administrative control lives)
# Should be a multi-sig account or hardware wallet
MAINNET_OWNER_ADDRESS="G..."

# AI agent address (hot key in backend infrastructure)
# This key will call rebalance() and update_total_assets()
MAINNET_AGENT_ADDRESS="G..."

# === USDC TOKEN ===
# Official Stellar Mainnet USDC token contract
# Verify at: https://stellar.expert/explorer/public/contract
MAINNET_USDC_TOKEN_ADDRESS="C..."

# === WASM CONTRACT ===
# SHA256 hash of the compiled vault contract WASM binary
# Compute with: sha256sum neurowealth-vault/contracts/vault/target/wasm32-unknown-unknown/release/neurowealth_vault.wasm
MAINNET_WASM_HASH="..."

# Optional: Deployment salt (auto-generated if omitted)
# Generate with: openssl rand -hex 32
# MAINNET_SALT="..."

# === OPERATIONAL CAPS (Conservative Launch Phase) ===
# All values in base units (USDC has 7 decimals)
# Example: 100 USDC = 1_000_000_000 base units

# Maximum total value locked in the vault
# Recommend: Start conservative (e.g., $100,000 = 1_000_000_000_000 base units)
MAINNET_TVL_CAP="1000000000000"

# Maximum deposit per user (protects against whale concentration)
# Recommend: $5,000 = 50_000_000_000 base units
MAINNET_USER_DEPOSIT_CAP="50000000000"

# Minimum per-transaction deposit (prevents dust attacks)
# Recommend: $1 = 10_000_000 base units
MAINNET_MIN_DEPOSIT="10000000"

# Maximum per-transaction deposit (large transaction limit)
# Recommend: $5,000 = 50_000_000_000 base units
MAINNET_MAX_DEPOSIT="50000000000"

# === PROTOCOL POOLS ===
# Contract addresses of yield protocols

# Blend Protocol lending pool (verified address)
# Verify at: https://stellar.expert/explorer/public/contract
MAINNET_BLEND_POOL_ADDRESS="C..."

# DEX Pool address (optional, for liquidity provision strategy)
# Verify at: https://stellar.expert/explorer/public/contract
# MAINNET_DEX_POOL_ADDRESS="C..."

# === OPERATIONAL SETTINGS (Optional) ===
# Rebalance cooldown in ledgers (~5 seconds per ledger)
# 0 = no cooldown, 200 = ~16 minutes
# Default: 0 (no cooldown)
# MAINNET_REBALANCE_COOLDOWN="0"

# Token approval TTL in ledgers (1,000–500,000 range)
# 52560 ledgers ≈ 30 days
# Default: 52560
# MAINNET_APPROVAL_TTL="52560"

# === NETWORK (DO NOT CHANGE FOR MAINNET) ===
SOROBAN_NETWORK_PASSPHRASE="Public Global Stellar Network ; Stellar Development Foundation"
SOROBAN_RPC_URL="https://soroban.stellar.org"

# === DEPLOYMENT OPTIONS ===
# Set to true for initial dry-run verification
MAINNET_DRY_RUN="true"

# Set to true to skip confirmation prompt (use with caution)
MAINNET_FORCE_DEPLOY="false"

# === VERIFICATION OPTIONS ===
# Set to true to run pause/unpause drill after deployment
RUN_PAUSE_DRILL="false"

# Set to true to run test deposit/withdraw cycle
RUN_TEST_DEPOSIT="false"

# =============================================================================
# SECURITY CHECKLIST
# =============================================================================
#
# Before running deploy-mainnet.sh, verify:
#
# ✓ Owner key is in a hardware wallet or multi-sig account
# ✓ Agent key is stored securely (AWS Secrets Manager, Vault, etc.)
# ✓ Deployer key is generated and funded with XLM
# ✓ WASM hash matches the release binary (verified by team)
# ✓ All pool addresses verified against official sources
# ✓ Caps are conservative for launch phase
# ✓ This file (.env.mainnet) is in .gitignore and NEVER committed
# ✓ All values have been reviewed by at least two team members
# ✓ Dry-run completed successfully
# ✓ Team has signed off on mainnet deployment
#
# =============================================================================
